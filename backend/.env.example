# ─────────────────────────────────────────────────────────────────────────────
# CEFI Backend — environment template. Copy to .env and fill in real values.
# .env is gitignored; never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# REQUIRED: RLS lets the browser only read the catalogue, so every admin
# write goes through the backend with this key. Never expose it to the frontend.

# ── Admin access ─────────────────────────────────────────────────────────────
# REQUIRED for any admin login to work. Comma-separated CONFIRMED emails
# allowed to use the admin API (checked in backend/middleware/auth.js). Users
# with app_metadata.role = "admin" in Supabase are admins regardless of this
# list. There is no default and no fallback value baked into the code — an
# admin email lives only in your .env (and in Vercel's env vars for production),
# never in frontend or backend source.
ADMIN_EMAILS=owner@yourcompany.com

# ── CORS ─────────────────────────────────────────────────────────────────────
# Extra origins allowed to call the API. Same-origin requests (frontend and
# /api on one Vercel domain) always work. In production, other origins are
# refused unless listed here.
FRONTEND_URL=https://yourdomain.com
FRONTEND_URL_WWW=https://www.yourdomain.com

# ── Order emails: Resend (primary) ───────────────────────────────────────────
# RESEND_API_KEY   — from resend.com/api-keys
# RESEND_FROM_EMAIL — REQUIRED for real customers. Must use a domain that is
#                     VERIFIED at resend.com/domains. Leaving this blank falls
#                     back to onboarding@resend.dev, which Resend only delivers
#                     to your own account address — customers get nothing.
# ADMIN_EMAIL      — fixed recipient of the internal "Order Confirmed" alert.
#                    The customer confirmation goes to whatever address the
#                    buyer typed at checkout; it is never configured here.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=CEFI Orders <orders@yourdomain.com>
RESEND_REPLY_TO=orders@yourdomain.com
ADMIN_EMAIL=you@yourcompany.com

# ── Order emails: Gmail SMTP (fallback only) ─────────────────────────────────
# Used when Resend refuses a customer address (i.e. domain not yet verified).
# EMAIL_PASS must be a 16-character Google App Password, not your login password.
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-16-char-app-password

# ── Order storage ────────────────────────────────────────────────────────────
# REQUIRED to store orders in Supabase (run supabase/migrations/ first).
# Customer name/email/phone/address are AES-256-GCM encrypted with this key
# before they reach the database. Without it, orders stay in memory only.
# 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a copy in your password manager: without it stored orders can't be read.
ORDER_DATA_KEY=your-base64-32-byte-key

# ── Sessions ─────────────────────────────────────────────────────────────────
# Signs the cookie that binds each session to the browser that signed in.
# Optional (derived from the service-role key if unset), but a dedicated
# random value means rotating one secret doesn't affect the other.
SESSION_SECRET=your-random-32-byte-secret

# ── Shared rate limiting (optional, recommended in production) ──────────────
# Upstash Redis REST credentials (free tier is enough). With these set, rate
# limits are shared across all Vercel instances; without them each instance
# counts on its own.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── Misc ─────────────────────────────────────────────────────────────────────
DEFAULT_CURRENCY=USD
