# ─────────────────────────────────────────────────────────────────────────────
# CEFI Backend — environment template. Copy to .env and fill in real values.
# .env is gitignored; never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com
FRONTEND_URL_WWW=https://www.yourdomain.com

# ── Order emails: Resend (primary) ───────────────────────────────────────────
# RESEND_API_KEY   — from resend.com/api-keys
# RESEND_FROM_EMAIL — REQUIRED for real customers. Must use a domain that is
#                     VERIFIED at resend.com/domains. Leaving this blank falls
#                     back to onboarding@resend.dev, which Resend only delivers
#                     to your own account address — customers get nothing.
# ADMIN_EMAIL      — fixed recipient of the internal "Order Confirmed" alert.
#                    The customer confirmation goes to whatever address the
#                    buyer typed at checkout; it is never configured here.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=CEFI Orders <orders@yourdomain.com>
RESEND_REPLY_TO=orders@yourdomain.com
ADMIN_EMAIL=you@yourcompany.com

# ── Order emails: Gmail SMTP (fallback only) ─────────────────────────────────
# Used when Resend refuses a customer address (i.e. domain not yet verified).
# EMAIL_PASS must be a 16-character Google App Password, not your login password.
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-16-char-app-password

# ── Misc ─────────────────────────────────────────────────────────────────────
DEFAULT_CURRENCY=USD
