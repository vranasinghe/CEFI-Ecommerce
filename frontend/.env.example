# Frontend build-time settings (Vite). Values here are baked into the public
# JavaScript bundle, so never put a secret in this file.
# Copy to frontend/.env for local runs; in Vercel add it under
# Settings -> Environment Variables and redeploy.

# Your real Google Analytics 4 measurement ID ("G-" followed by letters and
# digits, from Google Analytics -> Admin -> Data streams). Analytics loads only
# after a visitor accepts cookies, and never if this is empty.
VITE_GA_MEASUREMENT_ID=
